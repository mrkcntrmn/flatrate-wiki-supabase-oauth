{
  "name": "flatrate/wiki-supabase-oauth",
    "description": "Flarum 2.0.2 member experience restoration candidate for FlatRate. Not a production release.",
    "type": "flarum-extension",
  "license": "MIT",
  "keywords": [
    "flarum",
    "supabase",
    "oauth",
    "oauth2",
    "pkce",
    "sso",
    "nicknames"
  ],
  "homepage": "https://flatrate.wiki",
  "support": {
    "issues": "https://github.com/mrkcntrmn/flatrate-wiki-supabase-oauth/issues",
    "source": "https://github.com/mrkcntrmn/flatrate-wiki-supabase-oauth"
  },
  "require": {
    "php": ">=8.3",
    "flarum/core": "2.0.2"
  },
  "autoload": {
    "psr-4": {
      "FlatRate\\SupabaseOAuth\\": "src/"
    },
    "files": [
      "src/Support/Flarum2RuntimeCompat.php"
    ]
  },
  "extra": {
    "flarum-extension": {
      "title": "FlatRate Wiki Login F2 identity canary",
      "category": "feature",
      "icon": {
        "name": "fas fa-sign-in-alt",
        "backgroundColor": "#111827",
        "color": "#ffffff"
      }
    }
  }
}
