{
  "name": "flatrate/wiki-supabase-oauth",
  "description": "FlatRate Wiki Supabase OAuth 2.1 SSO provider and public-auth gate for Flarum 1.8.",
  "type": "flarum-extension",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "flarum/core": "^1.8.1",
    "fof/oauth": "^1.7.4",
    "fof/extend": "^1.3.4",
    "league/oauth2-client": "^2.7"
  },
  "autoload": {
    "psr-4": {
      "FlatRate\\SupabaseOAuth\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "FlatRate Wiki Login",
      "category": "feature",
      "icon": {
        "name": "fas fa-wrench",
        "backgroundColor": "#111827",
        "color": "#ffffff"
      }
    }
  }
}
