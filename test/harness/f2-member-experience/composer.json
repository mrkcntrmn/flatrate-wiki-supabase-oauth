    "fof/sitemap": "3.0.0",
    "fof/upload": "2.0.3",
    "flarum/extension-manager": "2.0.1",
    "league/flysystem-aws-s3-v3": "^3.0",
    "flatrate/wiki-supabase-oauth": "dev-restoration",
    "flatrate/flarum-forum-navigation": "dev-restoration",
    "flatrate/flarum-messaging-ui": "dev-restoration",
    "flatrate/flarum-private-messages-bridge": "dev-restoration",
    "flatrate/flarum-live-chat": "dev-restoration",
    "flatrate/flarum-media-privacy": "dev-restoration"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../sources/oauth",
      "options": {
        "symlink": true,
        "versions": {
          "flatrate/wiki-supabase-oauth": "dev-restoration"
        }
      }
    },
    {
      "type": "path",
      "url": "../sources/navigation",
      "options": {
        "symlink": true,
        "versions": {
          "flatrate/flarum-forum-navigation": "dev-restoration"
        }
      }
    },
    {
      "type": "path",
      "url": "../sources/messaging",
      "options": {
        "symlink": true,
        "versions": {
          "flatrate/flarum-messaging-ui": "dev-restoration"
        }
      }
    },
    {
      "type": "path",
      "url": "../sources/dm",
      "options": {
        "symlink": true,
        "versions": {
          "flatrate/flarum-private-messages-bridge": "dev-restoration"
        }
      }
    },
    {
      "type": "path",
      "url": "../sources/live",
      "options": {
        "symlink": true,
        "versions": {
          "flatrate/flarum-live-chat": "dev-restoration"
        }
      }
    },
    {
      "type": "path",
      "url": "../sources/media",
      "options": {
        "symlink": true,
        "versions": {
          "flatrate/flarum-media-privacy": "dev-restoration"
        }
      }
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": false,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
